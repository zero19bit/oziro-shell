# ==============================
# Oziro — Git ignore rules
# React + TypeScript + Vite frontend, Rust/Cargo workspace
# ==============================

# Dependencies
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Frontend build output and caches
dist/
build/
.vite/
.turbo/
.parcel-cache/
coverage/
.nyc_output/
*.tsbuildinfo

# Rust / Cargo build artifacts
/target/
**/target/
*.rs.bk

# Tauri generated/local state
.tauri/
src-tauri/target/
src-tauri/gen/

# Environment files and secrets
.env
.env.*
!.env.example
!.env.template
!.env.sample
*.pem
*.key
*.p12
*.pfx

# Logs and diagnostic output
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
*.stackdump

# Test and browser automation artifacts
playwright-report/
test-results/
storybook-static/

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
*~

# Operating system files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# IDE / editor local state
.idea/
.fleet/
.history/
*.code-workspace

# Local runtime files
*.pid
*.pid.lock
*.seed

# Keep important lockfiles under version control:
# Cargo.lock
# package-lock.json
# pnpm-lock.yaml
# yarn.lock
